# macOS 시스템 파일
.DS_Store
.AppleDouble
.LSOverride

# IDE 및 편집기 설정
.idea/
.vscode/
*.iml
.classpath
.project
.settings/

# Java / Gradle / Maven 빌드 산출물과 로컬 캐시
.gradle/
build/
target/
bin/
out/

# Node.js / Vue / Vite 의존성과 빌드 산출물
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python 가상환경, 캐시 및 테스트 산출물
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 환경변수 및 로컬 비밀 설정
.env
.env.*
!.env.example
!.env.*.example
application-local.*
application-secret.*

# 로그 및 임시 파일
*.log
*.tmp
*.swp
*.swo
.cache/
tmp/
temp/

# 로컬 배포 이미지와 전달용 압축 파일
